# Used by `vite build` (production mode) only; `npm run dev` keeps using .env / localhost.
# A VITE_API_BASE_URL set in the Vercel project (or a Docker build arg) takes precedence.
# Public value baked into the bundle – never put secrets in VITE_* variables.
VITE_API_BASE_URL=https://ragplatform.onrender.com/api/v1
