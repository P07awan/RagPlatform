# Copy to .env and fill in. NEVER commit .env. Values here are placeholders only.

# ---- Environment ---------------------------------------------------------------
# development | production | test. In production OPENAI_API_KEY and API_KEY are required.
ENVIRONMENT=development

# ---- OpenAI (required for ingestion, chat and evaluation) ------------------------
# API usage is billed separately from any ChatGPT subscription.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional: override embedding size (text-embedding-3-* only). Changing it requires a reindex.
EMBEDDING_DIMENSIONS=
# Optional: leave empty for models that reject a temperature parameter.
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=800
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=3

# ---- Qdrant -----------------------------------------------------------------------
# Local Docker: http://localhost:6333   Inside docker compose: http://qdrant:6333
# Qdrant Cloud: https://<cluster>.cloud.qdrant.io:6333 plus QDRANT_API_KEY
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=rag_documents
# Dev-only alternative without Docker: embedded on-disk Qdrant (single process).
# QDRANT_PATH=./data/qdrant

# ---- Chunking & retrieval -------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=10
RERANK_TOP_K=4
RRF_K=60

# ---- Reranker (local cross-encoder, ~90 MB download, ~200-400 MB RAM) -----------------
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# error = fail requests if the model cannot load; fusion = explicit, labelled fallback
RERANKER_FALLBACK=error
RERANKER_PRELOAD=false

# ---- LangSmith tracing (optional) ---------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=production-rag-platform
# Redact questions/documents/answers from traces
LANGSMITH_HIDE_CONTENT=false

# ---- Redis cache (optional) -----------------------------------------------------------
REDIS_URL=
ENABLE_CACHE=false
CACHE_TTL_SECONDS=3600

# ---- Security / API -------------------------------------------------------------------
# Application key expected in the X-API-Key header. Empty = auth disabled (dev only).
API_KEY=
# Comma-separated list of allowed browser origins (no wildcards).
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_SIZE_MB=20
MAX_FILES_PER_UPLOAD=10
RATE_LIMIT_PER_MINUTE=30
INGESTION_CONCURRENCY=2

# ---- Logging --------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
